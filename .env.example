# Local development only. Copy to .env; never commit the real token.
API_TOKEN=
LLM_BASE_URL=https://gatellm.ru/v1
LLM_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_RETRIES=1

# Data Platform
COMPOSE_PROJECT_NAME=agentic-data-platform
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8.33.6
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=agentic
CLICKHOUSE_PASSWORD=agentic_dev_only
DBT_IMAGE=agentic-data-platform-dbt:1.11.14-1.10.2
SCENARIO_GRADER_IMAGE=agentic-data-platform-grader:0.1.0

# MCP database identities; use distinct local secrets outside source control.
CLICKHOUSE_MCP_IMAGE=ghcr.io/clickhouse/mcp-clickhouse:0.6.0@sha256:b437cf15922702563d59124ad15f86337d93169cf2831d7fac6756d5dc23abff
MCP_CLICKHOUSE_USER=mcp_reader
MCP_CLICKHOUSE_READER_PASSWORD=mcp_reader_dev_only
DBT_MCP_IMAGE=agentic-data-platform-dbt-mcp:2.2.1-dbt1.11.14
MCP_DBT_USER=dbt_agent
MCP_DBT_PASSWORD=dbt_agent_dev_only

# Airflow local development only
AIRFLOW_COSMOS_IMAGE=agentic-data-platform-airflow:3.3.1-cosmos1.15.0-dbt1.11.14
AIRFLOW_POSTGRES_IMAGE=postgres:16.15-bookworm@sha256:bb3e1a57e5407e0a5280b4211980a5e537f4abd234a87014ac979849a78dd825
AIRFLOW_UID=50000
AIRFLOW_API_PORT=8080
# AIRFLOW_API_BASE_URL defaults to http://127.0.0.1:${AIRFLOW_API_PORT} in Make.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_only
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow_dev_only
AIRFLOW_MCP_USERNAME=airflow_observer
AIRFLOW_MCP_PASSWORD=airflow_observer_dev_only
AIRFLOW_TRIGGER_USERNAME=airflow_trigger
AIRFLOW_TRIGGER_PASSWORD=airflow_trigger_dev_only
AIRFLOW_FERNET_KEY=YWdlbnRpYy1kYXRhLXBsYXRmb3JtLWZlcm5ldC0wMV8=
AIRFLOW_JWT_SECRET=YWdlbnRpYy1kYXRhLXBsYXRmb3JtLWp3dC1kZXYtMDE=
AIRFLOW_API_SECRET_KEY=YWdlbnRpYy1kYXRhLXBsYXRmb3JtLWFwaS1kZXYtMDE=
AIRFLOW_API_REQUEST_TIMEOUT_SECONDS=10
AIRFLOW_API_POLL_TIMEOUT_SECONDS=300
AIRFLOW_API_POLL_INTERVAL_SECONDS=2
